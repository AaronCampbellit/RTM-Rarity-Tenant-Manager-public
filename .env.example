# RTM system configuration (ADR-017, layer 1). Copy to .env and adjust.
# Secrets stay here / in a secrets manager — never in app config or logs.

# ---- API ----
RTM_ENV=development
RTM_HTTP_ADDR=:8080
RTM_CORS_ORIGIN=http://localhost:5173
RTM_LOG_LEVEL=info

# ---- Database (required when RTM_ENV=production) ----
# The in-memory BETA ignores this; wire pgx to it as the data layer lands.
RTM_DATABASE_URL=postgres://rtm:rtm@localhost:5432/rtm?sslmode=disable

# ---- Microsoft Entra / Graph (server-side only; never sent to the frontend) ----
# RTM_ENTRA_CLIENT_ID=
# RTM_ENTRA_CLIENT_SECRET=
# RTM_ENTRA_TENANT_ID=

# ---- SharePoint administration (central multi-tenant certificate app) ----
# All three are required together. The certificate is public; keep the private
# key in a deployment secret store and mount both paths read-only.
# RTM_SHAREPOINT_CLIENT_ID=
# RTM_SHAREPOINT_CERTIFICATE_PATH=/run/rtm-secrets/sharepoint-app.crt
# RTM_SHAREPOINT_PRIVATE_KEY_PATH=/run/rtm-secrets/sharepoint-app.key

# ---- ThreatLocker (optional global MSP parent-org API credentials) ----
# Fallback for tenants that carry only their organization ID; tenants can
# instead store their own instance/token. Token comes from an API User in the
# ThreatLocker portal; instance is the portal region identifier (e.g. "g").
# The global ThreatLocker workspace also requires the MSP parent organization
# GUID; a tenant organization ID alone does not enable that workspace.
# RTM_THREATLOCKER_INSTANCE=
# RTM_THREATLOCKER_TOKEN=
# RTM_THREATLOCKER_PARENT_ORG_ID=

# ---- Signing / encryption keys ----
# RTM_JWT_SIGNING_KEY=   # random high-entropy value; required in production
# RTM_FIELD_ENCRYPTION_KEY= # base64-encoded random 32-byte key; required with Postgres in production
